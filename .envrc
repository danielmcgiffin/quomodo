if command -v npm >/dev/null 2>&1; then
  # NixOS global node_modules live in the Nix store (read-only), so use a user prefix.
  export NPM_CONFIG_PREFIX="${HOME}/.npm-global"
  export PATH="${NPM_CONFIG_PREFIX}/bin:${PATH}"
  mkdir -p "${NPM_CONFIG_PREFIX}"

  PI_AUTO_UPDATE_INTERVAL_SECONDS="${PI_AUTO_UPDATE_INTERVAL_SECONDS:-21600}"
  case "${PI_AUTO_UPDATE_INTERVAL_SECONDS}" in
    ''|*[!0-9]*) PI_AUTO_UPDATE_INTERVAL_SECONDS=21600 ;;
  esac

  PI_AUTO_UPDATE_CACHE_DIR="${XDG_CACHE_HOME:-${HOME}/.cache}/quomodo"
  PI_AUTO_UPDATE_STAMP_FILE="${PI_AUTO_UPDATE_CACHE_DIR}/npm-global-tools.last-check"
  PI_AUTO_UPDATE_LOCK_DIR="${PI_AUTO_UPDATE_CACHE_DIR}/npm-global-tools.lock"
  PI_AUTO_UPDATE_LOG_FILE="${PI_AUTO_UPDATE_CACHE_DIR}/npm-global-tools.log"

  mkdir -p "${PI_AUTO_UPDATE_CACHE_DIR}"

  sync_npm_global_package() {
    package="$1"
    package_label="$2"

    latest_version="$(npm view "$package" version 2>/dev/null)"
    if [ -z "$latest_version" ]; then
      echo "Unable to fetch latest $package_label version from npm."
      return
    fi

    installed_version="$(
      npm list -g --depth=0 --json "$package" 2>/dev/null | node -e '
const pkg = process.argv[1];
let data = "";
process.stdin.on("data", (chunk) => (data += chunk));
process.stdin.on("end", () => {
  try {
    const parsed = JSON.parse(data);
    console.log(parsed.dependencies?.[pkg]?.version || "");
  } catch (_) {}
});
' "$package"
    )"

    if [ -z "$installed_version" ]; then
      echo "$package_label not found; installing latest ($latest_version)..."
      npm install -g "$package@$latest_version"
    elif [ "$installed_version" != "$latest_version" ]; then
      echo "Updating $package_label to $latest_version..."
      npm install -g "$package@$latest_version"
    fi
  }

  should_run_npm_auto_update() {
    if [ "${PI_AUTO_UPDATE_FORCE:-0}" = "1" ]; then
      return 0
    fi

    if [ ! -f "${PI_AUTO_UPDATE_STAMP_FILE}" ]; then
      return 0
    fi

    now_epoch="$(date +%s)"
    last_epoch="$(cat "${PI_AUTO_UPDATE_STAMP_FILE}" 2>/dev/null)"

    case "$last_epoch" in
      ''|*[!0-9]*) return 0 ;;
    esac

    if [ $((now_epoch - last_epoch)) -ge "${PI_AUTO_UPDATE_INTERVAL_SECONDS}" ]; then
      return 0
    fi

    return 1
  }

  run_npm_auto_update_in_background() {
    (
      if ! mkdir "${PI_AUTO_UPDATE_LOCK_DIR}" 2>/dev/null; then
        exit 0
      fi
      trap 'rmdir "${PI_AUTO_UPDATE_LOCK_DIR}" >/dev/null 2>&1' EXIT

      # Stamp immediately so repeated `cd` calls stay fast while the updater runs.
      date +%s > "${PI_AUTO_UPDATE_STAMP_FILE}"

      cd "${HOME}" || exit 0

      {
        echo "[$(date -Is)] Checking global CLI updates..."
        sync_npm_global_package "@openai/codex" "Codex CLI"
        sync_npm_global_package "@mariozechner/pi" "Pi CLI"
        sync_npm_global_package "@mariozechner/pi-coding-agent" "Pi Coding Agent"
        echo "[$(date -Is)] Global CLI update check finished."
      } >> "${PI_AUTO_UPDATE_LOG_FILE}" 2>&1
    ) &
  }

  if should_run_npm_auto_update; then
    run_npm_auto_update_in_background
  fi
else
  echo "npm not found; install Node.js/npm to use Codex and Pi."
fi
