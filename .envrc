if command -v npm >/dev/null 2>&1; then
  # NixOS global node_modules live in the Nix store (read-only), so use a user prefix.
  export NPM_CONFIG_PREFIX="${HOME}/.npm-global"
  export PATH="${NPM_CONFIG_PREFIX}/bin:${PATH}"
  mkdir -p "${NPM_CONFIG_PREFIX}"

  sync_npm_global_package() {
    package="$1"
    package_label="$2"

    latest_version="$(npm view "$package" version 2>/dev/null)"
    if [ -z "$latest_version" ]; then
      echo "Unable to fetch latest $package_label version from npm."
      return
    fi

    installed_version="$(npm list -g --depth=0 --json "$package" 2>/dev/null | node -e 'const pkg=process.argv[1];let d="";process.stdin.on("data",c=>d+=c);process.stdin.on("end",()=>{try{const j=JSON.parse(d);console.log(j.dependencies?.[pkg]?.version||"");}catch(e){}});' "$package")"

    if [ -z "$installed_version" ]; then
      echo "$package_label not found; installing latest ($latest_version)..."
      npm install -g "$package@$latest_version"
    elif [ "$installed_version" != "$latest_version" ]; then
      echo "Updating $package_label to $latest_version..."
      npm install -g "$package@$latest_version"
    fi
  }

  sync_npm_global_package "@openai/codex" "Codex CLI"
  sync_npm_global_package "@mariozechner/pi" "Pi CLI"
  sync_npm_global_package "@mariozechner/pi-coding-agent" "Pi Coding Agent"
else
  echo "npm not found; install Node.js/npm to use Codex and Pi."
fi
